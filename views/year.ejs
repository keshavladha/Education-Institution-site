<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yearly Memories: 2010-2025</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6a11cb;
            --secondary: #2575fc;
            --accent: #ff4e50;
            --light: #f8f9fa;
            --dark: #212529;
        }
        
        body {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }
        
        .navbar {
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
        }
        
        .hero-section {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero-content {
            z-index: 2;
        }
        
        .hero-title {
            font-size: 4rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 3px 3px 10px rgba(0, 0, 0, 0.3);
        }
        
        .hero-subtitle {
            font-size: 1.5rem;
            margin-bottom: 2rem;
            max-width: 700px;
        }
        
        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 2rem;
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
            40% {transform: translateY(-20px) translateX(-50%);}
            60% {transform: translateY(-10px) translateX(-50%);}
        }
        
        .year-section {
            min-height: 100vh;
            padding: 100px 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 1s ease, transform 1s ease;
        }
        
        .year-section.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        .year-title {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 2rem;
            text-align: center;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
        }
        
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            margin: 0 auto;
            max-width: 1200px;
            padding: 20px;
        }
        
        .photo-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(5px);
            transition: transform 0.5s ease, box-shadow 0.5s ease;
        }
        
        .photo-card:hover {
            transform: translateY(-10px) scale(1.03);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }
        
        .photo-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            background-color: #5c2a9d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 4rem;
        }
        
        .photo-content {
            padding: 20px;
        }
        
        .photo-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .photo-desc {
            font-size: 0.9rem;
            opacity: 0.8;
        }
        
        .decade-divider {
            text-align: center;
            margin: 50px 0;
            position: relative;
        }
        
        .decade-text {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 30px;
            border-radius: 30px;
            font-size: 1.5rem;
            font-weight: 600;
        }
        
        .footer {
            background: rgba(0, 0, 0, 0.8);
            padding: 40px 0;
            text-align: center;
            margin-top: 50px;
        }
        
        /* Background shapes for visual interest */
        .bg-shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.2;
            z-index: 0;
        }
        
        .shape-1 {
            width: 300px;
            height: 300px;
            background: linear-gradient(45deg, #ff4e50, #f9d423);
            top: 10%;
            left: 5%;
            animation: float 15s infinite ease-in-out;
        }
        
        .shape-2 {
            width: 200px;
            height: 200px;
            background: linear-gradient(45deg, #3494E6, #EC6EAD);
            bottom: 15%;
            right: 10%;
            animation: float 12s infinite ease-in-out reverse;
        }
        
        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            25% { transform: translate(20px, 30px) rotate(5deg); }
            50% { transform: translate(0, 50px) rotate(0deg); }
            75% { transform: translate(-20px, 30px) rotate(-5deg); }
        }
        
        /* Responsive adjustments */
        @media (max-width: 992px) {
            .hero-title {
                font-size: 3rem;
            }
            
            .year-title {
                font-size: 2.8rem;
            }
        }
        
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }
            
            .year-title {
                font-size: 2.2rem;
            }
            
            .photo-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-camera me-2"></i>Yearly Memories
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#2010">2010</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#2015">2015</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#2020">2020</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#2025">2025</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
        
        <div class="hero-content container">
            <h1 class="hero-title">Journey Through the Years</h1>
            <p class="hero-subtitle">Explore memorable moments from 2010 to 2025 with our interactive timeline. Scroll down to travel through time!</p>
            <button class="btn btn-light btn-lg px-4 py-2">Get Started <i class="fas fa-arrow-down ms-2"></i></button>
        </div>
        
        <div class="scroll-indicator">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- Years Sections -->
    <main>
        <!-- 2010-2014 -->
        <div class="decade-divider" id="2010">
            <span class="decade-text">2010 - 2014</span>
        </div>
        
        <% for(let year = 2010; year <= 2014; year++) { %>
            <section class="year-section" id="<%= year %>">
                <h2 class="year-title"><%= year %></h2>
                <div class="photo-grid">
                    <% for(let i = 1; i <= 3; i++) { %>
                        <div class="photo-card">
                            <div class="photo-img">
                                <i class="fas fa-image"></i>
                            </div>
                            <div class="photo-content">
                                <h3 class="photo-title">Memory from <%= year %></h3>
                                <p class="photo-desc">A significant moment captured in time during this memorable year.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>
        
        <!-- 2015-2019 -->
        <div class="decade-divider" id="2015">
            <span class="decade-text">2015 - 2019</span>
        </div>
        
        <% for(let year = 2015; year <= 2019; year++) { %>
            <section class="year-section" id="<%= year %>">
                <h2 class="year-title"><%= year %></h2>
                <div class="photo-grid">
                    <% for(let i = 1; i <= 3; i++) { %>
                        <div class="photo-card">
                            <div class="photo-img">
                                <i class="fas fa-image"></i>
                            </div>
                            <div class="photo-content">
                                <h3 class="photo-title">Memory from <%= year %></h3>
                                <p class="photo-desc">A significant moment captured in time during this memorable year.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>
        
        <!-- 2020-2024 -->
        <div class="decade-divider" id="2020">
            <span class="decade-text">2020 - 2024</span>
        </div>
        
        <% for(let year = 2020; year <= 2024; year++) { %>
            <section class="year-section" id="<%= year %>">
                <h2 class="year-title"><%= year %></h2>
                <div class="photo-grid">
                    <% for(let i = 1; i <= 3; i++) { %>
                        <div class="photo-card">
                            <div class="photo-img">
                                <i class="fas fa-image"></i>
                            </div>
                            <div class="photo-content">
                                <h3 class="photo-title">Memory from <%= year %></h3>
                                <p class="photo-desc">A significant moment captured in time during this memorable year.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>
        
        <!-- 2025 -->
        <div class="decade-divider" id="2025">
            <span class="decade-text">2025</span>
        </div>
        
        <section class="year-section" id="2025">
            <h2 class="year-title">2025</h2>
            <div class="photo-grid">
                <% for(let i = 1; i <= 3; i++) { %>
                    <div class="photo-card">
                        <div class="photo-img">
                            <i class="fas fa-image"></i>
                        </div>
                        <div class="photo-content">
                            <h3 class="photo-title">Future Vision</h3>
                            <p class="photo-desc">What the future might hold as we look forward to this year.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <h3>Yearly Memories Gallery</h3>
            <p>Relive moments from 2010 to 2025</p>
            <div class="my-3">
                <a href="#" class="text-white mx-2"><i class="fab fa-facebook-f fa-lg"></i></a>
                <a href="#" class="text-white mx-2"><i class="fab fa-twitter fa-lg"></i></a>
                <a href="#" class="text-white mx-2"><i class="fab fa-instagram fa-lg"></i></a>
                <a href="#" class="text-white mx-2"><i class="fab fa-pinterest-p fa-lg"></i></a>
            </div>
            <p class="mb-0">© 2023 Yearly Memories. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Smooth scrolling for navigation links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    if(targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if(targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 80,
                            behavior: 'smooth'
                        });
                    }
                });
            });
            
            // Animation on scroll
            const yearSections = document.querySelectorAll('.year-section');
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if(entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.1
            });
            
            yearSections.forEach(section => {
                observer.observe(section);
            });
            
            // Hero section button scroll
            document.querySelector('.hero-content button').addEventListener('click', function() {
                window.scrollTo({
                    top: document.querySelector('#2010').offsetTop - 80,
                    behavior: 'smooth'
                });
            });
            
            // Parallax effect for background shapes
            window.addEventListener('scroll', function() {
                const scrolled = window.pageYOffset;
                const rate = scrolled * -0.5;
                
                const shapes = document.querySelectorAll('.bg-shape');
                shapes.forEach(shape => {
                    shape.style.transform = `translateY(${rate * 0.2}px) rotate(${rate * 0.05}deg)`;
                });
            });
        });
    </script>
</body>
</html>