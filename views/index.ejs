  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      line-height: 1.6;
      background: #f7f7f7;
      color: #333;
    }

    .hero {
      background: url('https://source.unsplash.com/1600x600/?education,students') no-repeat center center/cover;
      height: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      flex-direction: column;
    }
    .hero h2 { font-size: 48px; margin-bottom: 10px; }
    .hero p { font-size: 20px; }

    section {
      padding: 60px 40px;
      max-width: 1100px;
      margin: auto;
    }
    section h2 {
      text-align: center;
      margin-bottom: 30px;
      color: #2c3e50;
    }

    .grid {
      display:flex;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
    .card {
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.3s;
    }
    .card:hover { transform: translateY(-5px); }
    .card img { width: 100%; border-radius: 10px; }

    form {
      background: #fff;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      max-width: 500px;
      margin: auto;
    }
    form input, form textarea, form button {
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border-radius: 5px;
      border: 1px solid #ccc;
      font-size: 16px;
    }
    form button {
      background: #1abc9c;
      border: none;
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      transition: 0.3s;
    }
    form button:hover { background: #16a085; }
    p.message { text-align: center; font-weight: bold; }

    footer {
      background: #2c3e50;
      color: #fff;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>
